
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#080d18">
<title>NEWALPAEX-AI</title>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, sans-serif;
  background: #080d18;
  color: white;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

header {
  padding: 16px;
  background: #111a2c;
  border-bottom: 1px solid #263650;
  display: flex;
  align-items: center;
  gap: 12px;
}

.logo {
  width: 44px;
  height: 44px;
  background: linear-gradient(135deg,#1687ff,#8b5cf6);
  border-radius: 13px;
  display: grid;
  place-items: center;
  font-weight: bold;
  font-size: 23px;
}

header h2 {
  font-size: 19px;
}

header p {
  color: #55d99b;
  font-size: 12px;
  margin-top: 5px;
}

#chat {
  flex: 1;
  overflow-y: auto;
  padding: 18px 14px;
}

.welcome {
  text-align: center;
  margin: 75px auto 35px;
  max-width: 350px;
}

.welcome h1 {
  font-size: 29px;
  margin-bottom: 14px;
  background: linear-gradient(90deg,#36a4ff,#a78bfa);
  color: transparent;
  background-clip: text;
}

.welcome p {
  color: #9baac0;
  line-height: 1.6;
}

.message {
  max-width: 85%;
  padding: 13px 15px;
  border-radius: 15px;
  margin: 12px 0;
  line-height: 1.5;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.user {
  background: #1768ce;
  margin-left: auto;
}

.bot {
  background: #172338;
  border: 1px solid #2a3c57;
  margin-right: auto;
}

.input-area {
  padding: 12px;
  background: #111a2c;
  border-top: 1px solid #263650;
  display: flex;
  gap: 9px;
}

input {
  flex: 1;
  min-width: 0;
  padding: 15px;
  border: 1px solid #344761;
  border-radius: 12px;
  outline: none;
  background: #080d18;
  color: white;
  font-size: 15px;
}

button {
  border: none;
  border-radius: 12px;
  padding: 0 18px;
  background: #287ff0;
  color: white;
  font-size: 15px;
  font-weight: bold;
}

button:active {
  background: #145cc0;
}

footer {
  text-align: center;
  color: #72839b;
  font-size: 11px;
  padding: 10px;
  background: #111a2c;
}
</style>
</head>

<body>

<header>
  <div class="logo">N</div>
  <div>
    <h2>NEWALPAEX-AI</h2>
    <p>● Online Interface</p>
  </div>
</header>

<main id="chat">
  <div class="welcome" id="welcome">
    <h1>Welcome to NEWALPAEX-AI</h1>
    <p>Your intelligent assistant for learning, coding and creativity.</p>
  </div>
</main>

<div class="input-area">
  <input
    id="userInput"
    type="text"
    placeholder="Ask NEWALPAEX-AI..."
    autocomplete="off"
  >
  <button onclick="sendMessage()">Send</button>
</div>

<footer>
  NEWALPAEX-AI • Your AI Assistant
</footer>

<script>
const chat = document.getElementById("chat");
const input = document.getElementById("userInput");
const welcome = document.getElementById("welcome");

function addMessage(text, type) {
  const message = document.createElement("div");
  message.className = "message " + type;
  message.textContent = text;
  chat.appendChild(message);
  chat.scrollTop = chat.scrollHeight;
}

function sendMessage() {
  const text = input.value.trim();

  if (!text) return;

  welcome.style.display = "none";
  addMessage(text, "user");
  input.value = "";

  setTimeout(() => {
    addMessage(
      "Your message has been received. Real AI responses will be available after connecting the AI backend.",
      "bot"
    );
  }, 500);
}

input.addEventListener("keydown", function(event) {
  if (event.key === "Enter") {
    sendMessage();
  }
});
</script>

</body>
</html>
